[Unit]
Description=dcdash data center dashboard
Documentation=https://github.com/joernott/dcdash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dcdash
Group=dcdash
ExecStart=/usr/bin/dcdash --config /etc/dcdash/config.yaml serve
Restart=on-failure
RestartSec=5s
# data_dir (/var/lib/dcdash) and an optional audit log file (/var/log/dcdash).
StateDirectory=dcdash
StateDirectoryMode=0700
LogsDirectory=dcdash
LogsDirectoryMode=0750
UMask=0077

# Ports below 1024 (e.g. 443, or redirect_listen :80) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. dcdash only needs the network, its configuration (read-only) and the
# directories above; rndc (DNS module) runs as a child process with the same limits.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
