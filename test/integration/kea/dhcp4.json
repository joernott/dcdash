{
  "Dhcp4": {
    "interfaces-config": { "interfaces": [] },
    "control-sockets": [
      {
        "socket-type": "http",
        "socket-address": "0.0.0.0",
        "socket-port": 8000,
        "authentication": {
          "type": "basic",
          "realm": "kea",
          "directory": "/etc/kea",
          "clients": [ { "user": "dcdash", "password-file": "dcdash.password" } ]
        }
      }
    ],
    "lease-database": { "type": "memfile", "persist": false },
    "hosts-database": {
      "type": "postgresql",
      "host": "kea-db",
      "name": "kea",
      "user": "kea",
      "password": "kea-db-test-only",
      "on-fail": "serve-retry-continue"
    },
    "hooks-libraries": [
      { "library": "libdhcp_pgsql.so" },
      { "library": "libdhcp_lease_cmds.so" },
      { "library": "libdhcp_host_cmds.so" },
      { "library": "libdhcp_stat_cmds.so" },
      { "library": "libdhcp_subnet_cmds.so" }
    ],
    "valid-lifetime": 3600,
    "subnet4": [
      {
        "id": 1,
        "subnet": "192.0.2.0/24",
        "pools": [ { "pool": "192.0.2.100 - 192.0.2.199" }, { "pool": "192.0.2.200 - 192.0.2.209", "pool-id": 1 } ],
        "option-data": [ { "name": "routers", "data": "192.0.2.1" } ],
        "reservations": [
          { "hw-address": "aa:bb:cc:00:00:01", "ip-address": "192.0.2.10", "hostname": "printer" }
        ]
      },
      { "id": 2, "subnet": "198.51.100.0/24", "pools": [ { "pool": "198.51.100.10 - 198.51.100.19" } ] }
    ],
    "loggers": [ { "name": "kea-dhcp4", "output-options": [ { "output": "stdout" } ], "severity": "INFO" } ]
  }
}
